# Copy to .env and fill in the values. .env is not committed.

# PostgreSQL (see docker-compose.yml)
DATABASE_URL="postgresql://madiro:madiro@localhost:5432/madiro?schema=public"

# Which deployment this is: development | demo | production.
# NODE_ENV says how the code is BUILT; APP_ENV says what it is ALLOWED to do.
# DEMO and PROD are both production builds, so only APP_ENV tells them apart —
# it is what refuses the demo seed, a mocked vision provider and a pinned
# exchange rate in the shop's real books.
APP_ENV="development"

# Port for the API server itself. Read by apps/api (see env.validation.ts) and
# by Railway, which sets it per service. Defaults to 3000.
# PORT=3001

# --- Local port overrides -------------------------------------------------
# These two live in a ROOT .env next to docker-compose.yml (NOT in this file's
# copy), and exist for one case: another project on the machine already owns
# 5432 or 3000. Both default to the standard ports, so CI and a clean checkout
# need neither. Real environment variables always win over the file.
#
#   POSTGRES_PORT — host port compose publishes postgres on. Must match the
#                   port in DATABASE_URL above.
#   API_PORT      — where the vite dev/preview proxies, the e2e suite and
#                   scripts/test-env-reset.sh look for the API. Must match
#                   PORT above, which is what the API actually binds.
#
# POSTGRES_PORT=5433
# API_PORT=3001

# JWT — each secret must be >= 32 chars; generate with: openssl rand -hex 32
JWT_ACCESS_SECRET="replace-with-openssl-rand-hex-32-value"
JWT_REFRESH_SECRET="replace-with-openssl-rand-hex-32-value"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# CORS: comma-separated browser origins allowed to call the API
# (dashboard dev is 5173; add the scanner origin when it lands)
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# Initial administrator (created by the seed: pnpm --filter @madiro/api db:seed)
ADMIN_LOGIN="admin"
ADMIN_PASSWORD=""
ADMIN_NAME="Адміністратор"

# Label recognition. OpenRouter is the primary backend; Gemini is kept as an
# alternative and needs no key unless you actually select it.
OPENROUTER_API_KEY=""
GEMINI_API_KEY=""

# Optional model slug for OpenRouter. The provider ships a benchmarked default
# (fastest of the models that never misread a digit); set this only to adopt a
# different one without a redeploy. See openrouter.provider.ts.
OPENROUTER_MODEL=""

# Which vision provider to bind: auto | mock | gemini | openrouter.
#   auto       — OpenRouter key → OpenRouter, else Gemini key → Gemini, else
#                the mock outside production (default)
#   mock       — always the deterministic stand-in (38 / 36 / 7645); use it for
#                test runs so recognition never depends on a live model or
#                quota. Refused in production.
#   gemini     — always Gemini; the API refuses to start without a key.
#   openrouter — always OpenRouter; the API refuses to start without a key.
VISION_PROVIDER="auto"

# Per-minute rate limits. Defaults are the production values; an automated
# suite raises them (see e2e/playwright.config.ts), because being throttled
# mid-run only proves the limit exists. Keep the defaults in production.
AUTH_LOGIN_RATE_LIMIT="10"
AUTH_REFRESH_RATE_LIMIT="20"
GLOBAL_RATE_LIMIT="300"

# Fixes the USD→UAH rate instead of asking PrivatBank. For automated runs only:
# a suite that asserts stored hryvnia cannot depend on today's cash quote.
# Refused in production — a frozen rate there would misprice every purchase.
# EXCHANGE_RATE_USD="40"

# Logging level: fatal | error | warn | info | debug | trace | silent.
# Optional — defaults to info in production and debug elsewhere.
LOG_LEVEL=""
