# Copy to .env and fill in the values. .env is not committed.

# PostgreSQL (see docker-compose.yml)
DATABASE_URL="postgresql://madiro:madiro@localhost:5432/madiro?schema=public"

# JWT — each secret must be >= 32 chars; generate with: openssl rand -hex 32
JWT_ACCESS_SECRET="replace-with-openssl-rand-hex-32-value"
JWT_REFRESH_SECRET="replace-with-openssl-rand-hex-32-value"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# CORS: comma-separated browser origins allowed to call the API
# (dashboard dev is 5173; add the scanner origin when it lands)
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# Initial administrator (created by the seed: pnpm --filter @madiro/api db:seed)
ADMIN_LOGIN="admin"
ADMIN_PASSWORD=""
ADMIN_NAME="Адміністратор"

# Vision provider (phase 1: Gemini Flash)
GEMINI_API_KEY=""

# Which vision provider to bind: auto | mock | gemini.
#   auto   — key present → Gemini, else the mock outside production (default)
#   mock   — always the deterministic stand-in (38 / 36 / 7645); use it for
#            test runs so recognition never depends on a live model or quota.
#            Refused in production.
#   gemini — always Gemini; the API refuses to start without a key.
VISION_PROVIDER="auto"

# Per-minute rate limits. Defaults are the production values; an automated
# suite raises them (see e2e/playwright.config.ts), because being throttled
# mid-run only proves the limit exists. Keep the defaults in production.
AUTH_LOGIN_RATE_LIMIT="10"
AUTH_REFRESH_RATE_LIMIT="20"
GLOBAL_RATE_LIMIT="300"

# Logging level: fatal | error | warn | info | debug | trace | silent.
# Optional — defaults to info in production and debug elsewhere.
LOG_LEVEL=""
